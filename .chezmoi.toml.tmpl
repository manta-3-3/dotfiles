{{- $git_name := promptStringOnce . "git_name" "Enter Git Username" -}}
{{- $git_email := promptStringOnce . "git_email" "Enter Git Email" -}}
{{- $is_headless := promptBoolOnce . "is_headless" "Does this system run headless (without a GUI), answer with true/false?" false -}}

[data]
    git_name = {{ $git_name | quote }}
    git_email = {{ $git_email | quote }}
    is_headless = {{ $is_headless }}

[edit]
{{- if eq .chezmoi.os "windows" }}
    command = "code"
    args = ["--wait"]
{{- else }}
    command = "nano"
    args = []
{{- end }}
