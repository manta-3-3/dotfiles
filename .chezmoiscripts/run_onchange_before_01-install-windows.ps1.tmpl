{{- if eq .chezmoi.os "windows" -}}
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

Write-Host "`n==========================================" -ForegroundColor Cyan
Write-Host "   Checking Windows packages via Winget   " -ForegroundColor Cyan
Write-Host "==========================================" -ForegroundColor Cyan

{{- range $group, $packages := .packages.windows.winget }}
    {{- $configKey := printf "install_%s" $group }}
    {{- $installGroup := true }}
    {{- if hasKey $ $configKey }}{{ $installGroup = index $ $configKey }}{{ end }}

    {{- if $installGroup }}
    Write-Host "`n▶ Checking group: [ {{ $group }} ]..." -ForegroundColor Blue
    
    {{- range $package := $packages }}
    # Check if Winget recognizes it as installed
    $check = winget list --exact --id "{{ $package }}" 2>&1
    if ($LASTEXITCODE -ne 0 -or $check -match "No installed package found") {
        
        Write-Host "  ⚠ '{{ $package }}' is missing." -ForegroundColor Yellow
        $response = Read-Host "    Install it? [Y/n]"
        
        if ([string]::IsNullOrWhiteSpace($response) -or $response -match "^[Yy]$") {
            Write-Host "    ⚙ Installing {{ $package }}..." -ForegroundColor Cyan
            
            winget install --exact --id "{{ $package }}" -e --accept-package-agreements --accept-source-agreements
            
            # Error handling: Check if the installation command was successful
            if ($LASTEXITCODE -eq 0) {
                Write-Host "    ✓ Successfully installed {{ $package }}" -ForegroundColor Green
            } else {
                Write-Host "    ✗ Failed to install {{ $package }}. Moving to next package..." -ForegroundColor Red
            }
        } else {
            Write-Host "    ⊘ Skipped {{ $package }}" -ForegroundColor DarkYellow
        }
    }
    {{- end }}
    
    {{- else }}
    Write-Host "`n⏭ Skipping group: [ {{ $group }} ] (Disabled during 'chezmoi init')" -ForegroundColor DarkGray
    {{- end }}
{{- end }}

{{- end -}}
