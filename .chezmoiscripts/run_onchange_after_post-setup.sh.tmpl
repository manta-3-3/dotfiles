#!/bin/bash

set -uo pipefail

CYAN='\033[1;36m'
BLUE='\033[1;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m' # No Color

# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

echo -e "\n${CYAN}==========================================${NC}"
echo -e "${CYAN}   Running post-setup script (Windows/Linux)   ${NC}"
echo -e "${CYAN}==========================================${NC}"

{{- if eq .chezmoi.os "windows" }}

# On Windows, some config files must be located elsewhere, create a symbolic link to it.
config_symlink() {
    if ! command -v cmd >/dev/null 2>&1; then
        echo -e "${RED} Error: 'cmd' is not available! ${NC}"
        return 0
    fi

    local target_dir="$1"
    local target="$target_dir/$2"
    local source="$3"

    if [ ! -f "$source" ]; then
        echo -e "${RED} Error: $source is not available! ${NC}"
        return 0
    fi

    mkdir -p "$target_dir"

    if [ -e "$target" ] || [ -L "$target" ]; then
        echo -e "${RED} Error: A file or link already exists at $target ${NC}"
        return 0
    fi

    cmd //c mklink "$(cygpath -w "$target")" "$(cygpath -w "$source")"

    if [ -e "$target" ]; then
        echo -e "${GREEN} Symlink created at $target ${NC}"
    else
        echo -e "${RED} Error: Failed to create symlink at $target ${NC}"
    fi
}

config_symlink "$APPDATA/alacritty/" "alacritty.toml" "$HOME/.alacritty.toml"

config_symlink "$USERPROFILE/AppData/Local/nvim/" "init.lua" "$HOME/.config/nvim/init.lua"

{{- else if eq .chezmoi.os "linux" }}

fix_binary_naming() {
    local alt_name="$1"
    local original_name="$2"
    local target_dir="$HOME/.local/bin"
    local target="$target_dir/$original_name"

    if command -v "$original_name" >/dev/null 2>&1; then
        echo -e "${RED} '$original_name' is already occupied! ${NC}"
        return 0
    fi

    if ! command -v "$alt_name" >/dev/null 2>&1; then
        echo -e "${RED} '$alt_name' is not available! ${NC}"
        return 0
    fi

    mkdir -p "$target_dir"

    if [ -e "$target" ] || [ -L "$target" ]; then
        echo -e "${RED} Error: A file or link already exists at $target ${NC}"
        return 0
    fi

    echo -e "${YELLOW} Found '$alt_name'. Creating symlink for '$original_name'... ${NC}"
    ln -s $(which "$alt_name") "$target"
    echo -e "${GREEN} Symlink created at $target ${NC}"
}

# On older Ubuntu/Debian systems, below commands are installed differently due to a name clash, which can be resolved by creating a symlink.
fix_binary_naming "batcat" "bat"
fix_binary_naming "fdfind" "fd"
echo -e "${BLUE} Ensure ~/.local/bin is in your \$PATH. ${NC}"

{{- end -}}
