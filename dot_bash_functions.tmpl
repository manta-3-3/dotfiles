# Create a new (local) git repo
gnew() {
    if [ -z "$1" ]; then
        echo "Error: Please provide a directory name!";
        return 1;
    fi

    if mkdir -p "$1"; then
        cd "$1" || return 1;

        git init;

        touch .gitignore LICENSE;

        if [ ! -s README.md ]; then
            echo "# $(basename "$PWD")" > README.md;
        fi

        echo "Project '$(basename "$PWD")' has been successfully created in $PWD!";
    else
        echo "Error: The directory could not be created!";
        return 1;
    fi
}

# Show weather infos via https://wttr.in/
wttr() {
	curl -G --no-progress-meter --compressed "https://wttr.in/${1:-}?F"
}
wttr0() {
	curl -G --no-progress-meter --compressed "https://wttr.in/${1:-}?F0"
}
wttr1() {
	curl -G --no-progress-meter --compressed "https://wttr.in/${1:-}?F1"
}
wttr2() {
	curl -G --no-progress-meter --compressed "https://wttr.in/${1:-}?F2"
}
wttrg() {
	curl -G --no-progress-meter --compressed "https://v2.wttr.in/${1:-}?F"
}

# Cheat sheets from https://cheat.sh/
chtsh() {
	curl -G --no-progress-meter --compressed "https://cheat.sh/${1:-}"
}

# Cryptocurrencies exchange rates from https://rate.sx/
rate() {
	curl -G --no-progress-meter --compressed "https://chf.rate.sx/${1:-}"
}

# Generate QR-codes for strings via https://qrenco.de/
qrco() {
	if [ -z "${1:-}" ]; then
		curl -G --no-progress-meter --compressed https://qrenco.de/
	else
		echo "$1" | curl -G --no-progress-meter --compressed -F-=\<- https://qrenco.de/
	fi
}

# Translate from German <--> English via Translate Shell
